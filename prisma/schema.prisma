generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

model Event {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  date        DateTime
  status      String    @default("UPCOMING")
  isFeatured  Boolean   @default(false)
  attendance  String?
  location    String
  description String
  coverPhoto  String?
  type        EventType
  photos      String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum EventType {
  MADANIY
  TRIP
  SPORT
  WORKSHOP
  EDUCATION
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  coverPhoto  String?
  photos      String[] @default([])
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VisaArticle {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  content      String
  visaType     VisaType
  readTime     Int
  description  String
  isOutdated   Boolean  @default(false)
  outdatedLink String?
  featureImage String?
  author       String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum VisaType {
  D2
  D10
  E7
  GENERAL
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  src       String
  alt       String
  event     String
  year      Int
  eventName String
  createdAt DateTime @default(now())
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  photo     String?
  year      Int
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimelineEntry {
  id            String   @id @default(cuid())
  year          String
  description   String
  presidentName String?
  coverPhoto    String?
  quote         String?
  createdAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
